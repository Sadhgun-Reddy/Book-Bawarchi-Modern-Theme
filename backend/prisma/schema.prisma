generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  password       String
  phone          String?
  role           String
  profileImage   String?
  createdAt      DateTime        @default(now())
  catererProfile Caterer?
  donations      Donation[]
  enquiries      Enquiry[]       @relation("UserEnquiries")
  tickets        SupportTicket[]
}

model Caterer {
  id              String    @id @default(uuid())
  userId          String    @unique
  businessName    String
  description     String
  yearsExperience Int
  specialties     String
  certifications  String
  kitchenAddress  String
  serviceAreas    String
  capacity        String
  approvalStatus  String    @default("pending")
  profileViews    Int       @default(0)
  responseRate    Int       @default(0)
  profileImage    String?
  adminRemarks    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id])
  enquiries       Enquiry[] @relation("CatererEnquiries")
  menus           Menu[]
  recipes         Recipe[]
}

model Menu {
  id             String     @id @default(uuid())
  catererId      String
  name           String
  description    String?
  cuisineType    String
  dietaryOptions String
  isActive       Boolean    @default(true)
  approvalStatus String     @default("pending")
  createdAt      DateTime   @default(now())
  caterer        Caterer    @relation(fields: [catererId], references: [id])
  items          MenuItem[]
}

model MenuItem {
  id              String  @id @default(uuid())
  menuId          String
  name            String
  description     String?
  price           Float
  imageUrl        String?
  images          String
  preparationTime String?
  serves          Int?
  dietaryTags     String
  menu            Menu    @relation(fields: [menuId], references: [id])
}

model Enquiry {
  id                  String    @id @default(uuid())
  userId              String
  catererId           String?
  eventType           String
  eventDate           String
  guestCount          Int
  budget              Float?
  specialRequirements String?
  status              String    @default("sent")
  respondedAt         DateTime?
  createdAt           DateTime  @default(now())
  caterer             Caterer?  @relation("CatererEnquiries", fields: [catererId], references: [id])
  user                User      @relation("UserEnquiries", fields: [userId], references: [id])
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String
  subject   String
  message   String
  status    String   @default("Open")
  priority  String   @default("Medium")
  category  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Donation {
  id                  String   @id @default(uuid())
  donorId             String
  foodType            String
  quantity            String
  pickupLocation      String
  availabilityFrom    String
  availabilityTo      String
  status              String   @default("available")
  specialInstructions String?
  createdAt           DateTime @default(now())
  donor               User     @relation(fields: [donorId], references: [id])
}

model Recipe {
  id             String    @id @default(uuid())
  catererId      String
  title          String
  content        String
  images         String
  tags           String
  views          Int       @default(0)
  approvalStatus String    @default("pending")
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  caterer        Caterer   @relation(fields: [catererId], references: [id])
}

model Review {
  id           String  @id @default(uuid())
  authorName   String
  authorAvatar String?
  rating       Int
  text         String
  targetId     String
  status       String  @default("published")
  date         String
}
